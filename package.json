{
  "name": "interview-question-generator",
  "version": "2.0.0",
  "description": "AI-powered interview question generator using Gemini API — production-ready",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:backend": "jest server/tests --runInBand",
    "test:frontend": "jest public/tests --runInBand",
    "validate": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/user-event": "^14.5.2",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.2.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "backend",
        "testEnvironment": "node",
        "testMatch": ["<rootDir>/server/tests/**/*.test.js"],
        "transform": {}
      },
      {
        "displayName": "frontend",
        "testEnvironment": "jsdom",
        "testMatch": ["<rootDir>/public/tests/**/*.test.js"],
        "transform": {
          "^.+\\.js$": "babel-jest"
        },
        "setupFiles": ["<rootDir>/public/tests/setup.js"]
      }
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "public/js/**/*.js",
      "!server/server.js",
      "!**/node_modules/**"
    ],
    "coverageReporters": ["text", "lcov", "html"],
    "coverageDirectory": "coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}